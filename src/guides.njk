---
permalink: guides.html
permalinkPath: guides.html
title: "Guides pratiques pour voyager avec son chien"
description: "Train, avion, ferry, voyage à l'étranger, règles des plages, dangers de saison : les guides pratiques de Coco Explore pour partir avec son chien, vérifiés sur les sources officielles."
layout: base.njk
---
{%- set guideItems = [] %}
{%- for g in collections.guides %}{% set guideItems = (guideItems.push({ "@type": "ListItem", "position": loop.index, "name": g.data.h1, "url": "https://cocoexplore.com/" + (g.data.permalinkPath | cleanUrl) }), guideItems) %}{% endfor %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "ItemList", "name": "Guides pratiques pour voyager avec son chien", "itemListElement": guideItems } | dump | safe }}</script>
<section class="wrap guide-page">
  <span class="tag">Guides</span>
  <h1>Guides pratiques pour voyager avec son chien</h1>
  <p class="guide-lead">Les fiches de Coco Explore disent <em>où</em> aller avec son chien. Ces guides répondent au <em>comment</em> : transports, papiers, règles et dangers de saison. Chaque guide s'appuie sur les sources officielles, citées en bas de page, et indique sa date de mise à jour.</p>
  {%- set themes = [
    { id: "transports", titre: "Transports et formalités", kickers: ["Transport", "Formalités"], intro: "Voiture, train, avion, ferry et voyage à l'étranger : les règles et les papiers pour partir avec son chien." },
    { id: "regles", titre: "Règles et sécurité", kickers: ["Plages", "Balades", "Santé", "Bien-être", "Saison"], intro: "Plages, randonnée, urgences vétérinaires et dangers de saison : ce qu'il faut savoir sur place." },
    { id: "alimentation", titre: "Alimentation en voyage", kickers: ["Alimentation"], intro: "Une série proposée par <a href=\"https://bimo.dog\" target=\"_blank\" rel=\"sponsored noopener\">Bimo</a>, application de recettes maison pour chiens, relue par Coco Explore sur les sources vétérinaires et officielles citées dans chaque article." }
  ] %}
  <nav class="guide-themes-nav">
    {%- for t in themes %}<a href="#{{ t.id }}">{{ t.titre }}</a>{% endfor %}
  </nav>
  {%- for t in themes %}
  <section class="guide-theme" id="{{ t.id }}">
    <h2>{{ t.titre }}</h2>
    <p class="guide-theme-intro">{{ t.intro | safe }}</p>
    <div class="guide-list">
      {%- for g in collections.guides %}
      {%- if (g.data.kicker | string).split(" ·")[0] in t.kickers %}
      <a href="/{{ g.data.permalinkPath | cleanUrl }}" class="guide-card">
        <span class="tag">{{ g.data.kicker | safe }}</span>
        <h3>{{ g.data.h1 | safe }}</h3>
        <p>{{ g.data.description | safe }}</p>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}
</section>
