---
permalink: map-data.js
eleventyExcludeFromCollections: true
---
// Généré à partir des fiches du site — position approximative au niveau de la commune.
window.COCO_LIEUX = [
{%- for fiche in collections.fiches %}
  {
    "slug": {{ fiche.data.permalinkPath | dump | safe }},
    "titre": {{ fiche.data.h1 | dump | safe }},
    "lieu": {{ fiche.data.lieu | dump | safe }},
    "categorie": {{ fiche.data.tag | mapCategorie | dump | safe }},
    "img": {{ fiche.data.heroImage | dump | safe }},
    "lat": {{ fiche.data.lat }},
    "lng": {{ fiche.data.lng }}
  }{% if not loop.last %},{% endif %}
{%- endfor %}
];

// "Les conseils de Coco" de la semaine : une plage, une balade et un restaurant,
// choisis automatiquement chaque semaine parmi toutes les fiches du site
// (rotation par numéro de semaine — aucune liste à mettre à jour à la main).
window.COCO_CONSEILS_SEMAINE = {{ [
  collections.fiches | weeklyPick("Plage"),
  collections.fiches | weeklyPick("Balade"),
  collections.fiches | weeklyPick("Restaurant")
] | dump | safe }};
