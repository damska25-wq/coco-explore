---
pagination:
  data: collections.categoryDeptPages
  size: 1
  alias: dep
permalink: "{{ dep.cp.slug }}-{{ dep.slug }}.html"
layout: base.njk
eleventyComputed:
  title: "{{ dep.cp.titleDep | fill({ enNom: dep.enNom, n: dep.fiches.length }) }}"
  description: "{{ dep.cp.descDep | fill({ enNom: dep.enNom, n: dep.fiches.length, villes: (dep.fiches | ficheVilles(3)) }) }}"
  permalinkPath: "{{ dep.cp.slug }}-{{ dep.slug }}.html"
extraHead: |
  <style>
    .cat-page-intro { padding-top: 48px; padding-bottom: 12px; }
    .cat-page-intro p { max-width: 72ch; }
    .cat-page-intro h2 { font-size: 1.3rem; color: var(--heading); margin-top: 1.6em; }
    .cat-page-links { margin: 8px 0 0; padding-left: 1.2em; }
    .cat-page-links li { margin: 4px 0; }
    .cat-page-crumb { font-size: 0.85rem; color: rgba(var(--ink),0.6); margin-bottom: 12px; }
    .cat-page-crumb a { color: inherit; }
    .cat-page-brief ul { padding-left: 1.2em; max-width: 80ch; }
    .cat-page-brief li { margin: 8px 0; line-height: 1.5; }
  </style>
---
{%- set cp = dep.cp %}
<script type="application/ld+json">{{ dep.fiches | ficheItems | listJsonLd([{ name: "Coco Explore", path: "" }, { name: cp.label, path: cp.slug }, { name: dep.nom, path: cp.slug + "-" + dep.slug }], cp.h1Dep | fill({ enNom: dep.enNom })) | safe }}</script>
<section class="wrap cat-page-intro">
  <div class="cat-page-crumb"><a href="/">Coco Explore</a> / <a href="/{{ cp.slug }}">{{ cp.label }}</a> / {{ dep.nom }}</div>
  <span class="tag">{{ cp.tag }}</span>
  <h1>{{ cp.h1Dep | fill({ enNom: dep.enNom }) }}</h1>
  <p>{{ cp.introDep | fill({ enNom: dep.enNom, n: dep.fiches.length, villes: (dep.fiches | ficheVilles(15)) }) | safe }}</p>
</section>

<section class="fiches wrap">
  <div class="fiche-grid">
    {%- for fiche in dep.fiches %}
    {% include "fiche-card.njk" %}
    {%- endfor %}
  </div>
</section>

<section class="wrap cat-page-intro cat-page-brief">
  <h2>{{ cp.label }} {{ dep.enNom }} : l'essentiel de chaque adresse</h2>
  <ul>
    {%- for fiche in dep.fiches %}
    {%- set brief = fiche | ficheBrief %}
    <li><a href="/{{ fiche.data.permalinkPath | cleanUrl }}">{{ fiche.data.cardTitle | safe }}</a>{% if fiche.data.cardTag and not (fiche.data.cardTitle | lower).includes(fiche.data.cardTag | lower) %} ({{ fiche.data.cardTag | safe }}){% endif %}{% for b in brief %}{{ " — " if loop.first else " · " }}<strong>{{ b.label }}</strong> : {{ b.value }}{% endfor %}</li>
    {%- endfor %}
  </ul>
</section>

<section class="wrap cat-page-intro">
  <h2>Pour aller plus loin</h2>
  <ul class="cat-page-links">
    <li><a href="/departement-{{ dep.slug }}">Toutes les adresses pour voyager avec son chien {{ dep.enNom }}</a> (plages, balades, hébergements, vétérinaires…)</li>
    {%- for other in collections.categoryDeptPages | whereEq("id", dep.id) %}
    {%- if other.cat != dep.cat %}
    <li><a href="/{{ other.cp.slug }}-{{ dep.slug }}">{{ other.cp.linkDep | fill({ enNom: dep.enNom }) }}</a> ({{ other.fiches.length }})</li>
    {%- endif %}
    {%- endfor %}
    {%- for other in collections.categoryDepts | whereEq("cat", dep.cat) | whereEq("region", dep.region) %}
    {%- if other.id != dep.id %}
    <li><a href="{% if other.hasPage %}/{{ cp.slug }}-{{ other.slug }}{% else %}/{{ cp.slug }}#{{ cp.slug }}-{{ other.slug }}{% endif %}">{{ cp.label }} {{ other.enNom }}</a> ({{ other.fiches.length }} {{ cp.unit[1] if other.fiches.length > 1 else cp.unit[0] }})</li>
    {%- endif %}
    {%- endfor %}
    <li><a href="/{{ cp.slug }}">{{ cp.linkNat }}</a></li>
  </ul>
</section>
