---
pagination:
  data: departements
  size: 1
  alias: dep
permalink: "departement-{{ dep.slug }}.html"
permalinkPath: "departement-{{ dep.slug }}.html"
layout: base.njk
eleventyComputed:
  title: "{{ dep.seoTitle }}"
  description: "{{ dep.seoDescription }}"
  extraHead: |
    <link rel="stylesheet" href="vendor/leaflet/leaflet.css">
---
<section class="hero" style="padding-bottom: 2rem;">
  <div class="wrap">
    <div class="hero-text">
      <span class="kicker">Explorer par secteur</span>
      <h1>{{ dep.seoH1 }}</h1>
      <p>{{ dep.intro | safe }}</p>
      <p style="margin-top: 8px; color: rgba(34,48,58,0.7); font-size: 0.95rem;">{{ collections.fiches | countByDept(dep.id) }} fiches dans ce département.</p>
    </div>
  </div>
</section>

<div class="wrap coco-map-wrap">
  <div id="coco-dept-map" data-dept="{{ dep.id }}"></div>
</div>

{%- set deptFilters = [
  { id: "tout", label: "Tout" },
  { id: "plages", label: "Plages" },
  { id: "lacs", label: "Lacs" },
  { id: "hebergements", label: "Hébergements" },
  { id: "balades", label: "Balades" },
  { id: "restaurants", label: "Restaurants" },
  { id: "veterinaires", label: "Vétérinaires" },
  { id: "toiletteurs", label: "Toiletteurs" },
  { id: "dogwash", label: "Douche à chien" },
  { id: "dogsitters", label: "Garde de chien" },
  { id: "activites", label: "Parcs canins" }
] %}
<div class="wrap">
  <div class="dept-filter-row" id="dept-filter-row" role="group" aria-label="Filtrer les fiches par catégorie">
    {%- for f in deptFilters %}
    <button type="button" class="dept-filter-btn{% if loop.first %} active{% endif %}" data-cat="{{ f.id }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}">{{ f.label }}</button>
    {%- endfor %}
  </div>
  <p class="dept-filter-empty" id="dept-filter-empty" hidden>Pas encore de fiche ici, on y travaille !</p>
</div>

{% for section in sections %}
{%- if section.catGrid %}
{%- set deptFiches = collections.fiches | byCategoryAndDept(section.catGrid.countIds, dep.id) %}
{%- if deptFiches.length > 0 %}
<section class="fiches wrap" id="{{ section.id }}">
  <div class="section-head">
    <span class="eyebrow">{{ section.catGrid.label | safe }}</span>
    <h2>{{ section.heading | safe }}</h2>
  </div>
  <div class="fiche-grid">
    {%- for fiche in deptFiches %}
    {%- set badge = (fiche.data.infoItems | accessBadge) if (fiche.data.breadcrumbCatId == "plages" or fiche.data.breadcrumbCatId == "cote-azur") else ((fiche.data.infoItems | vetBadge) if fiche.data.breadcrumbCatId == "veterinaires" else null) %}
    <a href="{{ fiche.data.permalinkPath }}" class="fiche-card">
      <div class="thumb">
        {%- set cardSrcset = fiche.data.heroImage | imgSrcset %}
        <img src="{{ fiche.data.heroImage | safe }}"{% if cardSrcset %} srcset="{{ cardSrcset | safe }}" sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px"{% endif %} alt="{{ fiche.data.cardTitle | safe }} — {{ fiche.data.cardTag | safe }}" loading="lazy">
        {%- if badge %}<span class="access-badge {{ badge.cls }}">{{ badge.label }}</span>{%- endif %}
      </div>
      <div class="body">
        <span class="tag">{{ fiche.data.cardTag | safe }}</span>
        <h3>{{ fiche.data.cardTitle | safe }}</h3>
        <p>{{ fiche.data.cardTeaser | safe }}</p>
        <div class="pictos-row">
          {%- for picto in fiche.data.cardPictos %}
          <span class="picto"><svg><use href="#{{ picto }}"/></svg></span>
          {%- endfor %}
        </div>
      </div>
    </a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- endif %}
{% endfor %}

<section class="categories wrap">
  <div class="section-head">
    <span class="eyebrow">Explorer plus loin</span>
    <h2>D'autres départements</h2>
  </div>
  <div class="region-accordion" id="region-accordion">
    {%- for region in regions %}
    <div class="region-accordion-item">
      <button type="button" class="region-accordion-toggle" aria-expanded="false">
        <span>{{ region.nom }}</span>
        <span class="region-accordion-meta">{{ region.departements.length }} départements <svg class="region-accordion-chevron" width="20" height="20"><use href="#i-chevron-down"/></svg></span>
      </button>
      <div class="cat-grid region-accordion-body" hidden>
        {%- for other in region.departements %}
        <a href="departement-{{ other.slug }}.html" class="cat-card">
          <svg class="icon"><use href="#i-pin"/></svg>
          <h3>{{ other.nom }}</h3>
          <span class="count">{{ collections.fiches | countByDept(other.id) }} fiches</span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

<script src="vendor/leaflet/leaflet.js"></script>
<script src="map-data.js"></script>
<script src="dept-map.js"></script>
<script src="dept-filter.js" defer></script>
<script src="region-accordion.js" defer></script>
