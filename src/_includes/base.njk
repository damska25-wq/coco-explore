    </symbol>
    <symbol id="i-house" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 11.5 12 4l8 7.5"/>
      <path d="M6 10v9.5h12V10"/>
      <path d="M10 19.5V14h4v5.5"/>
    </symbol>
    <symbol id="i-lake" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
