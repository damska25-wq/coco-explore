---
layout: base.njk
extraScripts: |
  <script src="avis.js" defer></script>
  <script src="favoris.js" defer></script>
---
{%- set jsonLdPlace = {
  "@context": "https://schema.org",
  "@type": breadcrumbCatId | schemaType,
  "name": h1,
  "description": description,
  "image": heroImage,
  "url": "https://cocoexplore.com/" + permalinkPath,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": lieu,
    "addressRegion": "Provence-Alpes-Côte d'Azur",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": lat,
    "longitude": lng
  }
} %}
<script type="application/ld+json">{{ jsonLdPlace | dump | safe }}</script>
{%- set jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Coco Explore", "item": "https://cocoexplore.com/" },
    { "@type": "ListItem", "position": 2, "name": breadcrumbCatLabel, "item": "https://cocoexplore.com/index.html#" + breadcrumbCatId },
    { "@type": "ListItem", "position": 3, "name": breadcrumbLast, "item": "https://cocoexplore.com/" + permalinkPath }
  ]
} %}
<script type="application/ld+json">{{ jsonLdBreadcrumb | dump | safe }}</script>
<section class="fiche-hero">
  <img class="fiche-hero-img" src="{{ heroImage | safe }}" alt="{{ h1 | safe }}, {{ tag | lower | safe }} à {{ lieu | safe }}" loading="eager">
  <button type="button" class="fav-toggle" id="fav-toggle" data-slug="{{ permalinkPath }}" aria-pressed="false" aria-label="Ajouter aux favoris">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6.1L12 17l-5.4 3 1.3-6.1-4.6-4.2 6.1-.6z"/></svg>
  </button>
  <div class="wrap">
    <div class="breadcrumb"><a href="index.html">Coco Explore</a> / <a href="index.html#{{ breadcrumbCatId }}">{{ breadcrumbCatLabel | safe }}</a> / {{ breadcrumbLast | safe }}</div>
    <span class="tag">{{ tag | safe }}</span>
    <h1>{{ h1 | safe }}</h1>
    <span class="lieu">{{ lieu | safe }}</span>
  </div>
  <span class="fiche-photo-credit">Photo : <a href="https://unsplash.com/@{{ photoUsername | safe }}?utm_source=coco_explore&amp;utm_medium=referral" target="_blank" rel="noopener">{{ photoName | safe }}</a> / <a href="https://unsplash.com/?utm_source=coco_explore&amp;utm_medium=referral" target="_blank" rel="noopener">Unsplash</a></span>
</section>

<section class="info-strip">
  <div class="wrap info-grid">
    {%- for item in infoItems %}
    <div class="info-item">
      <svg class="icon"><use href="#{{ item.icon }}"/></svg>
      <div><span class="label">{{ item.label | safe }}</span><span class="value">{{ item.value | safe }}</span></div>
    </div>
    {%- endfor %}
    {%- if siteWeb %}
    <div class="info-item">
      <svg class="icon"><use href="#i-link"/></svg>
      <div><span class="label">Site officiel</span><span class="value"><a href="{{ siteWeb | safe }}" target="_blank" rel="noopener nofollow">Voir le site ↗</a></span></div>
    </div>
    {%- endif %}
    {%- set shareText = "Regarde cette adresse dog-friendly trouvée sur Coco Explore : " + h1 + " (" + lieu + ") — https://cocoexplore.com/" + permalinkPath %}
    <div class="info-item">
      <svg class="icon"><use href="#i-whatsapp"/></svg>
      <div><span class="label">Partager</span><span class="value"><a href="https://wa.me/?text={{ shareText | urlencode }}" target="_blank" rel="noopener">Sur WhatsApp</a></span></div>
    </div>
    {%- set reportSubject = "Signalement — " + h1 %}
    {%- set reportBody = "Bonjour,\n\nJe souhaite signaler une information à corriger sur la fiche « " + h1 + " » :\nhttps://cocoexplore.com/" + permalinkPath + "\n\nCe qui ne correspond plus :\n[décris ici]\n\nMerci !" %}
    <div class="info-item">
      <svg class="icon"><use href="#i-alert"/></svg>
      <div><span class="label">Une erreur ?</span><span class="value"><a href="mailto:contact@cocoexplore.com?subject={{ reportSubject | urlencode }}&amp;body={{ reportBody | urlencode }}">Nous la signaler</a></span></div>
    </div>
  </div>
</section>

<section class="wrap avis" data-fiche="{{ avisSlug }}" id="avis">
  <div class="avis-card">
    <div class="avis-head">
      <h2>Avis &amp; photos</h2>
      <p>Partage ton passage avec Coco : quelques mots, une photo si tu en as une.</p>
    </div>

    <form class="avis-form" novalidate>
      <div class="avis-form-row">
        <input type="text" name="name" placeholder="Ton prénom" maxlength="60" required>
        <label class="avis-photo-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13.5" r="3.5"/></svg>
          <span>Photo</span>
          <input type="file" name="photo" accept="image/*" hidden>
        </label>
      </div>
      <textarea name="message" rows="2" maxlength="500" placeholder="Comment ça s'est passé avec ton chien ?" required></textarea>
      <div class="avis-preview" hidden>
        <img alt="Aperçu de la photo">
        <button type="button" aria-label="Retirer la photo">×</button>
      </div>
      <button type="submit" class="avis-submit">Publier l'avis</button>
      <p class="avis-status" role="status"></p>
    </form>

    <div class="avis-list">
      <p class="avis-empty">Sois le premier à partager ton avis sur ce lieu.</p>
    </div>
  </div>
</section>

{{ bodyHtml | safe }}
