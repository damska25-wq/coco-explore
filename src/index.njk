---
layout: base.njk
permalinkPath: ""
permalink: "index.html"
title: "Plages, balades et lieux où les chiens sont autorisés en PACA"
description: "Plages, balades, lacs, hébergements et restaurants où les chiens sont acceptés dans toute la région PACA : Var, Alpes-Maritimes et plus, avec Coco comme guide."
extraHead: |
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Coco Explore",
    "url": "https://cocoexplore.com/",
    "description": "Le guide pour sortir avec son chien en PACA : plages, balades, lacs, hébergements, restaurants, toiletteurs, vétérinaires et plus, avec Coco comme guide.",
    "publisher": {
      "@type": "Organization",
      "name": "Coco Explore",
      "url": "https://cocoexplore.com/",
      "logo": "https://cocoexplore.com/assets/coco-hero.jpg"
    }
  }
  </script>
extraScripts: |
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="map-data.js"></script>
  <script src="map.js"></script>
  <script src="search.js"></script>
  <script src="favoris.js" defer></script>
---
<section class="hero">
  <div class="wrap">
    <div class="hero-text">
      <span class="kicker">Où aller avec son chien en région PACA</span>
      <h1>Partout avec mon chien</h1>
      <p>Coco explore les plages, les sentiers et les bonnes adresses de toute la région PACA, de Cavalaire-sur-Mer aux Hautes-Alpes, pour te dire, avant d'y aller, si ton chien y sera vraiment le bienvenu.</p>
      <div class="search-wrap">
        <form class="search-bar" id="site-search-form" autocomplete="off">
          <input type="text" id="site-search-input" placeholder="Une plage, une balade, un lieu…">
          <button type="submit" aria-label="Rechercher"><svg width="16" height="16"><use href="#i-search"/></svg></button>
        </form>
        <div class="search-results" id="site-search-results" hidden></div>
      </div>
      <div class="share-site">
        <a href="https://wa.me/?text={{ 'Coco Explore : un guide gratuit pour trouver des plages, balades et adresses où aller avec son chien dans toute la région PACA — https://cocoexplore.com/' | urlencode }}" target="_blank" rel="noopener" class="share-site-btn">
          <svg width="16" height="16"><use href="#i-whatsapp"/></svg> Partager Coco Explore
        </a>
        <button type="button" id="copy-link-btn" class="share-site-btn share-site-btn-ghost">
          <svg width="16" height="16"><use href="#i-link"/></svg> Copier le lien
        </button>
        <span id="copy-link-status" class="copy-link-status" role="status"></span>
      </div>
    </div>
    <figure class="hero-photo">
      <img src="assets/coco-hero.jpg" alt="Coco, labrador et mascotte de Coco Explore, en balade en laisse">
      <figcaption>Coco, votre guide sur le terrain</figcaption>
    </figure>
  </div>
</section>

<section class="fiches wrap" id="mes-favoris" hidden>
  <div class="section-head">
    <span class="eyebrow">Mes favoris</span>
    <h2>Tes fiches sauvegardées</h2>
  </div>
  <div class="fiche-grid" id="mes-favoris-grid"></div>
</section>

<section class="wrap conseils-semaine" id="conseils">
  <div class="section-head">
    <span class="eyebrow">Les conseils de Coco</span>
    <h2>Cette semaine, Coco recommande…</h2>
  </div>
  <div class="conseils-layout">
    <div class="conseils-cards" id="coco-conseils-list"></div>
    <div class="coco-map-wrap">
      <div id="coco-map"></div>
      <div id="coco-map-filters"></div>
    </div>
  </div>
</section>

<section class="categories wrap">
  <div class="section-head">
    <span class="eyebrow">Explorer par catégorie</span>
    <h2>Où emmener son chien</h2>
  </div>
  <div class="cat-grid">
    {%- for section in sections %}
    {%- if section.catGrid %}
    <a href="index.html#{{ section.id }}" class="cat-card">
      <svg class="icon"><use href="#{{ section.catGrid.icon }}"/></svg>
      <h3>{{ section.catGrid.label | safe }}</h3>
      <span class="count">{{ collections.fiches | countByCats(section.catGrid.countIds) }} fiches</span>
    </a>
    {%- endif %}
    {%- endfor %}
  </div>
</section>

<section class="categories wrap">
  <div class="section-head">
    <span class="eyebrow">Explorer par secteur</span>
    <h2>Toute la région PACA, département par département</h2>
  </div>
  <div class="cat-grid">
    {%- for dep in departements %}
    <a href="departement-{{ dep.slug }}.html" class="cat-card">
      <svg class="icon"><use href="#i-pin"/></svg>
      <h3>{{ dep.nom }}</h3>
      <span class="count">{{ collections.fiches | countByDept(dep.id) }} fiches</span>
    </a>
    {%- endfor %}
  </div>
</section>

<section class="fiches wrap" id="nouveautes">
  <div class="section-head">
    <span class="eyebrow">Nouveautés</span>
    <h2>Les dernières fiches ajoutées</h2>
  </div>
  <div class="fiche-grid">
    {%- for fiche in collections.fiches | latest(6) %}
    {%- set badge = fiche.data.infoItems | accessBadge if fiche.data.breadcrumbCatId == "plages" or fiche.data.breadcrumbCatId == "cote-azur" else null %}
    <a href="{{ fiche.data.permalinkPath }}" class="fiche-card">
      <div class="thumb">
        <img src="{{ fiche.data.heroImage | safe }}" alt="{{ fiche.data.cardTitle | safe }} — {{ fiche.data.cardTag | safe }}" loading="lazy">
        {%- if badge %}<span class="access-badge {{ badge.cls }}">{{ badge.label }}</span>{%- endif %}
      </div>
      <div class="body">
        <span class="tag">{{ fiche.data.cardTag | safe }}</span>
        <h3>{{ fiche.data.cardTitle | safe }}</h3>
        <p>{{ fiche.data.cardTeaser | safe }}</p>
        <div class="pictos-row">
          {%- for picto in fiche.data.cardPictos %}
          <span class="picto"><svg><use href="#{{ picto }}"/></svg></span>
          {%- endfor %}
        </div>
      </div>
    </a>
    {%- endfor %}
  </div>
</section>

{% for section in sections %}
<section class="fiches wrap" id="{{ section.id }}">
  <div class="section-head">
    <span class="eyebrow">{{ section.eyebrow | safe }}</span>
    <h2>{{ section.heading | safe }}</h2>
    {%- if section.intro %}
    <p style="margin-top: 10px; color: rgba(34,48,58,0.7); font-size: 0.95rem;">{{ section.intro | safe }}</p>
    {%- endif %}
  </div>
  <div class="fiche-grid">
    {%- for fiche in collections.fiches | byCategory(section.id) %}
    {%- set badge = fiche.data.infoItems | accessBadge if section.id == "plages" or section.id == "cote-azur" else null %}
    <a href="{{ fiche.data.permalinkPath }}" class="fiche-card">
      <div class="thumb">
        <img src="{{ fiche.data.heroImage | safe }}" alt="{{ fiche.data.cardTitle | safe }} — {{ fiche.data.cardTag | safe }}" loading="lazy">
        {%- if badge %}<span class="access-badge {{ badge.cls }}">{{ badge.label }}</span>{%- endif %}
      </div>
      <div class="body">
        <span class="tag">{{ fiche.data.cardTag | safe }}</span>
        <h3>{{ fiche.data.cardTitle | safe }}</h3>
        <p>{{ fiche.data.cardTeaser | safe }}</p>
        <div class="pictos-row">
          {%- for picto in fiche.data.cardPictos %}
          <span class="picto"><svg><use href="#{{ picto }}"/></svg></span>
          {%- endfor %}
        </div>
      </div>
    </a>
    {%- endfor %}
  </div>
</section>
{% endfor %}
