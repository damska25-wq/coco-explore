---
permalink: map-data.js
eleventyExcludeFromCollections: true
---
// Généré à partir des fiches du site — position approximative au niveau de la commune.
// Minifié volontairement (pas d'indentation) : ce fichier liste les ~4650 fiches du site.
window.COCO_LIEUX=[
{%- for fiche in collections.fiches %}
{"slug":{{ fiche.data.permalinkPath | cleanUrl | dump | safe }},"titre":{{ fiche.data.h1 | dump | safe }},"lieu":{{ fiche.data.lieu | dump | safe }},"categorie":{{ fiche.data.tag | mapCategorie | dump | safe }},"catId":{{ fiche.data.breadcrumbCatId | dump | safe }},"departement":{{ fiche.data.departement | dump | safe }},{% set im = fiche.data.heroImage | optimizeImg %}{% if "images.unsplash.com/photo-" in im %}"u":{{ im.split("photo-")[1].split("?")[0] | dump | safe }}{% else %}"img":{{ im | dump | safe }}{% endif %},"lat":{{ fiche.data.lat | round(4) }},"lng":{{ fiche.data.lng | round(4) }}{% set avisKey = fiche.data.permalinkPath | cleanUrl | replace("fiche-", "") %}{% if fiche.data.avisSlug and fiche.data.avisSlug != avisKey %},"avis":{{ fiche.data.avisSlug | dump | safe }}{% endif %}}{% if not loop.last %},{% endif %}
{%- endfor %}
];
window.COCO_PAGES=[
{%- for city in collections.cityPages %}
{"slug":{{ city.slug | dump | safe }},"titre":{{ (city.ville + " avec son chien") | dump | safe }},"lieu":{{ city.dep.nom | dump | safe }},"categorie":"Page ville"},
{%- endfor %}
{%- for cp in categoryPages %}
{"slug":{{ cp.slug | dump | safe }},"titre":{{ (cp.label + " avec son chien en France") | dump | safe }},"lieu":"France","categorie":"Catégorie","catId":{{ cp.cat | dump | safe }}},
{%- endfor %}
{%- for d in collections.categoryDeptPages %}
{"slug":{{ (d.cp.slug + "-" + d.slug) | dump | safe }},"titre":{{ (d.cp.label + " " + d.enNom) | dump | safe }},"lieu":{{ d.nom | dump | safe }},"categorie":"Département","catId":{{ d.cp.cat | dump | safe }}},
{%- endfor %}
{%- for vc in collections.cityCategoryPages %}
{"slug":{{ vc.slug | dump | safe }},"titre":{{ (vc.cp.label + " " + vc.enNom) | dump | safe }},"lieu":{{ vc.city.ville | dump | safe }},"categorie":"Page ville","catId":{{ vc.cp.cat | dump | safe }}},
{%- endfor %}
{%- for g in collections.guides %}
{"slug":{{ g.data.permalinkPath | cleanUrl | dump | safe }},"titre":{{ g.data.h1 | dump | safe }},"lieu":{{ g.data.description | dump | safe }},"categorie":"Guide"}{% if not loop.last %},{% endif %}
{%- endfor %}
];
window.COCO_ZONES=[
{%- for region in regions %}
{"n":{{ region.nom | dump | safe }},"d":[{% for dep in region.departements %}{{ dep.id | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}]},
{%- for dep in region.departements %}
{"n":{{ dep.nom | dump | safe }},"d":[{{ dep.id | dump | safe }}]},
{%- endfor %}
{%- endfor %}
{"n":"Corse","d":["2A","2B"]},{"n":"Alsace","d":["67","68"]},{"n":"Provence","d":["04","13","83","84"]},{"n":"PACA","d":["04","05","06","13","83","84"]},
{"n":"Côte d'Azur","d":["06","83"]},{"n":"Pays basque","d":["64"]},{"n":"Côte basque","d":["64"]},{"n":"Camargue","d":["13","30"]},{"n":"Pyrénées","d":["09","31","64","65","66"]},{"n":"Alpes","d":["04","05","06","38","73","74"]}
];
