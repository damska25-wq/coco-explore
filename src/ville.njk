---
pagination:
  data: collections.cityPages
  size: 1
  alias: city
permalink: "{{ city.slug }}.html"
layout: base.njk
eleventyComputed:
  title: "{{ city.ville }} avec son chien : {{ city.fiches.length }} adresses"
  description: "Où aller avec son chien {{ city.aVille }} : balades, restaurants, hébergements, vétérinaires, toiletteurs… {{ city.fiches.length }} adresses référencées par Coco Explore, avec les règles et conditions d'accueil."
  permalinkPath: "{{ city.slug }}.html"
extraHead: |
  <style>
    .cat-page-intro { padding-top: 48px; padding-bottom: 12px; }
    .cat-page-intro p { max-width: 72ch; }
    .cat-page-crumb { font-size: 0.85rem; color: rgba(var(--ink),0.6); margin-bottom: 12px; }
    .cat-page-crumb a { color: inherit; }
    .ville-section .section-head .cat-see-more { text-align: left; }
    .ville-links { margin: 8px 0 0; padding-left: 1.2em; }
    .ville-links li { margin: 4px 0; }
    .ville-sources { font-size: 0.85rem; color: rgba(var(--ink),0.6); }
  </style>
---
<script type="application/ld+json">{{ city.fiches | ficheItems | listJsonLd([{ name: "Coco Explore", path: "" }, { name: city.dep.nom, path: "departement-" + city.dep.slug }, { name: city.ville, path: city.slug }], city.ville + " avec son chien") | safe }}</script>
<section class="wrap cat-page-intro">
  <div class="cat-page-crumb"><a href="/">Coco Explore</a> / <a href="/departement-{{ city.dep.slug }}">{{ city.dep.nom }}</a> / {{ city.ville }}</div>
  <span class="tag">Ville</span>
  <h1>{{ city.ville }} avec son chien</h1>
  {%- set comma = joiner(", ") %}
  <p>Coco Explore référence <strong>{{ city.fiches.length }} adresses {{ city.aVille }}</strong> pour sortir avec son chien :
  {%- for section in sections %}{% if section.catGrid %}{% set n = (city.fiches | inCategories(section.catGrid.countIds)).length %}{% if n %}{{ comma() or " " }}{{ section.catGrid.label | lower | safe }} ({{ n }}){% endif %}{% endif %}{% endfor %}.
  Chaque fiche précise les règles et les conditions d'accueil du chien que nous avons pu vérifier.</p>
  {%- set essentiel = villesEssentiel[city.slug] %}
  {%- if essentiel %}
  <h2>L'essentiel avec son chien {{ city.aVille }}</h2>
  {{ essentiel.html | safe }}
  <p class="ville-sources">Sources : {% for s in essentiel.sources %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
  {%- endif %}
</section>

{%- for section in sections %}
{%- if section.catGrid %}
{%- set sectionFiches = city.fiches | inCategories(section.catGrid.countIds) %}
{%- if sectionFiches.length %}
<section class="fiches wrap ville-section" id="{{ section.id }}">
  <div class="section-head">
    <span class="eyebrow">{{ section.catGrid.label | safe }}</span>
    <h2>{{ section.heading | safe }}</h2>
    {%- set catPage = section.id | categoryPage %}
    {%- set cityCat = (collections.cityCategoryPages | whereEq("slug", (catPage.slug if catPage else "") + "-" + city.slug | replace("-avec-son-chien", "")))[0] if catPage else null %}
    {%- if cityCat %}
    <p class="cat-see-more"><a href="/{{ cityCat.slug }}">{{ catPage.label }} {{ city.aVille }} : la page dédiée →</a></p>
    {%- endif %}
    {%- if catPage %}
    {%- set catDep = (collections.categoryDeptPages | whereEq("cat", catPage.cat) | whereEq("id", city.dep.id))[0] %}
    {%- if catDep %}
    <p class="cat-see-more"><a href="/{{ catPage.slug }}-{{ catDep.slug }}">{{ catPage.linkDep | fill({ enNom: catDep.enNom }) }} →</a></p>
    {%- endif %}
    {%- endif %}
  </div>
  <div class="fiche-grid">
    {%- for fiche in sectionFiches %}
    {% include "fiche-card.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- endif %}
{%- endfor %}

{%- if city.nearby.length %}
<section class="fiches wrap ville-section" id="autour">
  <div class="section-head">
    <span class="eyebrow">À proximité</span>
    <h2>Autour {{ city.deVille }}</h2>
    <p>Adresses des communes voisines, à moins de 12 km du centre {{ city.deVille }}, les plus proches d'abord.</p>
  </div>
  <div class="fiche-grid">
    {%- for fiche in city.nearby %}
    {% include "fiche-card.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<section class="wrap cat-page-intro">
  <h2>Pour aller plus loin</h2>
  <ul class="ville-links">
    <li><a href="/departement-{{ city.dep.slug }}">Toutes les adresses pour voyager avec son chien {{ city.dep.id | deptEnNom }}</a></li>
    {%- for other in collections.cityPages | whereEq("dep", city.dep) %}
    {%- if other.ville != city.ville %}
    <li><a href="/{{ other.slug }}">{{ other.ville }} avec son chien</a> ({{ other.fiches.length }} adresses)</li>
    {%- endif %}
    {%- endfor %}
  </ul>
</section>
